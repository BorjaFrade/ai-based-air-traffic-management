{
  "ENROUTE": {
    "profile_name": "En-route / RVSM (data-driven colour scale)",
    "logic_version": "2026-11-04-v4-data-driven-mmin-tau",
    "horizontal_nm": 5.0,
    "vertical_ft": 1000.0,
    "comparison": {
      "loss_horizontal": "<",
      "loss_vertical": "<",
      "boundary_is_safe": true,
      "vertical_tolerance_ft": 1.0,
      "description": "Loss of separation requires H < 5 NM AND effective V < 1000 ft (i.e. m < 1, with m = max(H/5 NM, V/1000 ft)). A raw vertical separation within +/-1 ft of 1000 ft is normalised to exactly 1000 ft before the rule comparison."
    },
    "prediction": {
      "lookahead_minutes": [
        20
      ],
      "prediction_step_seconds": 10,
      "evaluation_period_seconds": 120,
      "predictor": "route_following",
      "predictor_description": "Path built from the SCAT predicted-trajectory fixes, travelled at the observed ground speed; altitude from the observed altitude. Constant-velocity extrapolation is only a comparison predictor.",
      "normalised_separation": "m(t) = max(H(t)/5 NM, V(t)/1000 ft)",
      "m_min": "minimum of m(t) over the lookahead",
      "tau_minutes": "time from now until m_min is reached",
      "event_state_aggregation": "colour_from_m_min_and_tau",
      "evaluation_order": [
        "RED_LOSS_OF_SEPARATION",
        "ORANGE_HIGH_RISK",
        "YELLOW_PROXIMITY_WARNING",
        "GREEN_NORMAL_OPERATION"
      ],
      "vertical_rate_deadband_fpm": 100.0,
      "logic": "data_driven_mmin_tau",
      "description": "Colours depend on the predicted minimum normalised separation (m_min) over the next 20 min and on the time tau until it occurs. No active-separator deterioration condition is used. Thresholds are nested boxes: m=1 is 5 NM / 1000 ft, m=1.2 is 6 NM / 1200 ft, m=2 is 10 NM / 2000 ft. All inequalities are strict where written '<'."
    },
    "states": {
      "GREEN_NORMAL_OPERATION": {
        "state": "NORMAL",
        "enabled": true,
        "display_name": "Normal separation",
        "colour": "#00A651",
        "rule": "otherwise",
        "description": "m_min >= 2, or 1 <= m_min < 1.2 (passes just outside 5 NM / 1000 ft), or no event within the lookahead."
      },
      "YELLOW_PROXIMITY_WARNING": {
        "state": "PROXIMITY",
        "enabled": true,
        "display_name": "Proximity warning",
        "colour": "#FFD400",
        "horizontal_nm": 10.0,
        "vertical_ft": 2000.0,
        "excluded_inner_horizontal_nm": 6.0,
        "excluded_inner_vertical_ft": 1200.0,
        "m_min_min_inclusive": 1.2,
        "m_min_max_exclusive": 2.0,
        "tau_minutes_min": 0.0,
        "tau_minutes_max": 20.0,
        "requires_active_separator_deterioration": false,
        "rule": "1.2 <= m_min < 2 at any tau within the lookahead"
      },
      "ORANGE_HIGH_RISK": {
        "state": "HIGH_RISK",
        "enabled": true,
        "display_name": "Predicted loss of separation (5-20 min)",
        "colour": "#FF6F00",
        "horizontal_nm": 5.0,
        "vertical_ft": 1000.0,
        "m_min_max_exclusive": 1.0,
        "tau_minutes_min_inclusive": 5.0,
        "tau_minutes_max_inclusive": 20.0,
        "requires_active_separator_deterioration": false,
        "rule": "m_min < 1 and 5 <= tau <= 20 min"
      },
      "RED_LOSS_OF_SEPARATION": {
        "state": "CONFLICT",
        "enabled": true,
        "display_name": "Loss of separation (current or predicted within 5 min)",
        "colour": "#D7191C",
        "horizontal_nm": 5.0,
        "vertical_ft": 1000.0,
        "vertical_tolerance_ft": 1.0,
        "vertical_rate_deadband_fpm": 100.0,
        "horizontal_operator": "<",
        "vertical_operator": "<",
        "m_min_max_exclusive": 1.0,
        "tau_minutes_min_inclusive": 0.0,
        "tau_minutes_max_exclusive": 5.0,
        "rule": "m_min < 1 and tau < 5 min (tau = 0 is the current loss of separation)"
      }
    },
    "calibration": {
      "status": "proposal",
